# Private planning documents — candid self-assessment and personal
# budget figures. Kept local; not part of the public portfolio repo.
risks.md
solutions.md
budget.md

# Docker Desktop's disk image, if it is ever pointed inside this
# folder. 15 GB of virtual disk must never reach git.
DockerDesktopWSL/
*.vhdx

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Environment and secrets
.env
.env.*
*.pem
*.key

# Run artefacts
runs/
logs/
*.log

# Run records and harness output — they live in ~/bs-work, never here
# (ADR-0011). Second line of defence if a command runs in the wrong folder.
records/
*.dev-*.json
gold.*.json

# Test fixtures are real harness output kept on purpose; exempt them
# from the *.log and *.dev-*.json rules above.
!tests/fixtures/**
